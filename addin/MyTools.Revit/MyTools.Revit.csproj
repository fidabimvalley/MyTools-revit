<Project Sdk="Microsoft.NET.Sdk">
  <!-- The add-in Revit loads. Holds no Python engine: that lives in MyTools.Engine, loaded in its own context. -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>MyTools.Revit</AssemblyName>
    <RootNamespace>MyTools.Revit</RootNamespace>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2025.*" ExcludeAssets="runtime" PrivateAssets="all" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2025.*" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
